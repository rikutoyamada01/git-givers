datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
}

model User {
  id            String          @id @default(cuid())
  name          String?
  // Public handle shown in profile (typically GitHub username)
  username      String?         @unique
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  // GitKarma specific
  karma         Int             @default(0)
  transactions  Transaction[]
  registeredRepositories Repository[] @relation("RegisteredRepositories")
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  boosts    Boost[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Repository {
  id          String   @id @default(cuid())
  githubId    Int      @unique // GitHub Repository ID
  name        String
  fullName    String
  url         String
  description String?
  stargazersCount Int @default(0)

  registeredById String
  registeredBy   User     @relation("RegisteredRepositories", fields: [registeredById], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issues      Issue[]
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Int
  description String?
  
  userId      String   @default("cmitmmd980000q8883y99y6ys")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Optional: Link to a repository if relevant
  repositoryId String?
  
  createdAt   DateTime @default(now())
}

model Issue {
  id          String   @id @default(cuid())
  githubId    Int      @unique
  number      Int
  title       String
  body        String?
  state       String
  htmlUrl     String
  
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  
  // Anti-Gaming: Track who created the issue on GitHub
  authorGithubId Int?
  authorLogin    String?

  assigneeId   String?
  // We can add relation to User if we want to track assignee within our system
  // assignee     User?   @relation(fields: [assigneeId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  boosts      Boost[]
}

model Boost {
  id        String   @id @default(cuid())
  amount    Int
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}
